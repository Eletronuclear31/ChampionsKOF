# Copy to /etc/championskof/bot-kof2002.env and chmod 600.

CHAMPIONS_BOT_BASE_URL=http://127.0.0.1:8080/
CHAMPIONS_BOT_DRIVER=kof2002
CHAMPIONS_BOT_SLOT=1
CHAMPIONS_BOT_NICK=Matador
CHAMPIONS_BOT_ROOM_PREFIX=PUBLIC
CHAMPIONS_BOT_PROFILE=beginner
CHAMPIONS_BOT_LEVEL=0
CHAMPIONS_BOT_HEARTBEAT_SECONDS=10
CHAMPIONS_BOT_STATUS_SIGNAL_SECONDS=60
CHAMPIONS_BOT_METRICS_PATH=/opt/championskof/shared/bots/kof2002-01/native_bot_metrics.jsonl
CHAMPIONS_BOT_APP_VERSION=1.0.18
CHAMPIONS_BOT_APP_BUILD=215
CHAMPIONS_BOT_NEUTRAL_INPUT=0
CHAMPIONS_BOT_RELAY_FRAME_HZ=60
