# ChampionsKOF Lura VPS environment.
# Copy to /etc/championskof/championskof.env and chmod 600.

YZKOF_SERVER_TIMEZONE=America/Sao_Paulo
YZKOF_DAILY_FICHAS=50
YZKOF_ADMIN_TOKEN=replace-with-long-random-admin-token
YZKOF_FIELD_TELEMETRY_TOKEN=replace-with-long-random-field-token

# MySQL is the production database for this VPS.
# Create the database and app user before enabling the services.
YZKOF_DATABASE_URL=mysql+pymysql://championskof:REPLACE_DB_PASSWORD@127.0.0.1:3306/championskof?charset=utf8mb4

# Replace SERVER_IP_OR_DNS with the VPS public address or DNS name.
YZKOF_PUBLIC_BASE_URLS=http://SERVER_IP_OR_DNS:8080/
YZKOF_PUBLIC_RELAY_HOST=SERVER_IP_OR_DNS
YZKOF_PUBLIC_RELAY_PORT=7000
YZKOF_PUBLIC_RELAY_ID=lura-sp2
YZKOF_PUBLIC_RELAY_REGION=br-sao-paulo-2
YZKOF_RELAY_NODES_JSON=[{"id":"lura-sp2","host":"SERVER_IP_OR_DNS","port":7000,"region":"br-sao-paulo-2","role":"primary","primary":true,"enabled":true}]

YZKOF_DISABLE_EMBEDDED_RELAY=1
YZKOF_RELAY_TELEMETRY_LOG=/opt/championskof/shared/data/realtime_relay_metrics.jsonl

# Avatar operational budget for the first phase. Enforcement belongs to the
# avatar upload feature; this value is documented for deploy monitoring.
CHAMPIONS_AVATAR_ROOT=/opt/championskof/shared/avatars
CHAMPIONS_AVATAR_BUDGET_BYTES=5368709120

# Optional SMTP values for account recovery.
CHAMPIONS_SMTP_HOST=
CHAMPIONS_SMTP_PORT=465
CHAMPIONS_SMTP_USERNAME=
CHAMPIONS_SMTP_PASSWORD=
CHAMPIONS_SMTP_FROM=
CHAMPIONS_SMTP_SECURITY=ssl
