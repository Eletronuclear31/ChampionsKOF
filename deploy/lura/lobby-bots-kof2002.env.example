# Copy to /etc/championskof/lobby-bots-kof2002.env and chmod 600.

CHAMPIONS_LOBBY_BOT_BASE_URL=http://127.0.0.1:8080/
CHAMPIONS_LOBBY_BOT_DRIVER=kof2002
CHAMPIONS_LOBBY_BOT_NAMES="Rugal08,Kyo_Vortex,Iori33,Orochi,MestreKOF,AshCrisonX,Dona Maria,Bozo,Cipher,Vítima,Carrasco,Zero"
CHAMPIONS_LOBBY_BOT_ACTIVE_COUNT=8
CHAMPIONS_LOBBY_BOT_ROTATION_BATCH_SIZE=4
CHAMPIONS_LOBBY_BOT_ROTATION_INTERVAL_SECONDS=21600
CHAMPIONS_LOBBY_BOT_ROTATION_GAP_SECONDS=300
CHAMPIONS_LOBBY_BOT_STAGGER_SECONDS=15
CHAMPIONS_LOBBY_BOT_HEARTBEAT_SECONDS=10
CHAMPIONS_LOBBY_BOT_METRICS_PATH=/opt/championskof/shared/bots/kof2002-lobby/lobby_bot_metrics.jsonl
CHAMPIONS_LOBBY_BOT_ACCOUNT_NAMESPACE=championskof-lobby
CHAMPIONS_LOBBY_BOT_SLOT_OFFSET=100
CHAMPIONS_LOBBY_BOT_BUILD_LABEL=lobby-bot-v0
