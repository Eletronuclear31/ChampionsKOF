[Unit]
Description=ChampionsKOF API
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
Type=simple
User=championskof
Group=championskof
WorkingDirectory=/opt/championskof/current/online_server
EnvironmentFile=/etc/championskof/championskof.env
ExecStart=/opt/championskof/current/online_server/.venv/bin/python /opt/championskof/current/online_server/server.py --host 0.0.0.0 --port 8080 --disable-embedded-relay --data-dir /opt/championskof/shared/data
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/championskof/shared /opt/championskof/current/online_server

[Install]
WantedBy=multi-user.target
